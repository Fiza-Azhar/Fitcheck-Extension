# Copy to .env and fill in. Only the Supabase URL + ANON key belong here — they
# are safe to ship (RLS protects the data). Never put the Groq key or the Supabase
# service_role key in this extension.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Default base URL of the FitCheck Expo server (hosts /api/analyze-item). The demo
# runs it locally; changeable in the extension popup.
VITE_ANALYZE_BASE_URL=http://localhost:8081
